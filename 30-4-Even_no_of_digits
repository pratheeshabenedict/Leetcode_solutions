Find Numbers with Even Number of Digits

C++ solution:
class Solution {
public:
    int findNumbers(vector<int>& nums) {
        int cnt=0;
        int count=0;
        for(int i=0;i<nums.size();i++){
            count=0;
            while(nums[i]!=0){
                nums[i]/=10;
                count++;
            }
            if(count%2==0){
                cnt++;
            }
        }
        return cnt;
    }
};


